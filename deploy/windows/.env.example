# RecipeCollater configuration. Copy this file next to RecipeCollater.exe and rename it ".env".
# It is read once at startup; anything already set in the Windows environment wins over it.
# Never commit a filled-in copy - it holds your API keys.

# --- AI extraction (needed for YouTube, and for web pages without embedded recipe data) ---
# Provider: auto | openai | anthropic   (auto = whichever key below is filled in)
RC_AI_PROVIDER=openai

# OpenAI - https://platform.openai.com/api-keys
RC_OPENAI_API_KEY=
RC_OPENAI_MODEL=gpt-4o-mini

# Anthropic (optional alternative) - https://console.anthropic.com/settings/keys
RC_ANTHROPIC_API_KEY=
RC_ANTHROPIC_MODEL=claude-sonnet-5

# Spend caps in USD. A call is only made when spending is under the cap.
RC_AI_DAILY_CAP_USD=1.00
RC_AI_MONTHLY_CAP_USD=10.00

# --- Network ---
# Port to serve on. 80 gives clean URLs (http://mini-pc) but the app must run as admin;
# use e.g. 8765 to avoid that (http://mini-pc:8765).
RC_PORT=80

# Hostnames/IPs allowed to reach the app, comma-separated. Include this PC's LAN name and IP.
RC_ALLOWED_HOSTS=localhost,127.0.0.1,MINI-PC,mini-pc.local,192.168.0.223

# The address shown in the app's "Add to phone" instructions - how devices reach this PC.
APP_BASE_URL=http://192.168.0.223

# --- Data location ---
# Database, images, artifacts, and backups. Defaults to a "data" folder beside the exe.
# To keep using your existing recipes, point this at the current data folder:
RC_DATA_DIR=C:\Users\aaron\Documents\recipiecollater\data
