# RecipeCollater environment — copy to /etc/recipecollater/env (root-owned, chmod 0600).
# NEVER commit a filled-in copy of this file. Secrets live only here.

# Single source of truth for links, Shortcut templates, callbacks (CONVENTIONS §11).
APP_BASE_URL=http://recipes.local

# Host-header allowlist. Add the N95's reserved LAN IP if you use it as a fallback.
RC_ALLOWED_HOSTS=recipes.local,localhost,127.0.0.1

# Where the SQLite databases, images, artifacts, and backups live.
RC_DATA_DIR=/var/lib/recipecollater

# Backups should target a DIFFERENT physical device (USB/NAS mount), not the system SSD.
RC_BACKUP_DIR=/mnt/backup/recipecollater

# deploy/install.sh appends a random RC_SETUP_TOKEN to the installed environment file.
# It is required only to create the very first administrator.

# Set to 1 only if you install the optional mkcert/Tailscale HTTPS upgrade (adds the
# Secure cookie flag). Leave unset/0 for the default plain-HTTP LAN setup.
# RC_HTTPS=0

# AI provider keys (either or both). Kept here, never in the repo. RC_AI_PROVIDER picks
# "anthropic", "openai" or "auto" (first configured key, Anthropic preferred).
# RC_ANTHROPIC_API_KEY=
# RC_OPENAI_API_KEY=
# RC_AI_PROVIDER=auto

# Models are chosen per task. The FAST model runs one-shot structured work (recipe extraction,
# tagging, receipts, typed-description drafts); the other runs the meal-planning assistant and
# recipe-photo drafting. Defaults below; a typo'd id only fails at call time, so check
# `journalctl -u recipecollater-worker` after changing one. New ids need a rate in
# app/ai/pricing.py or the spend cap prices them at the (high) unknown-model rate.
# RC_ANTHROPIC_MODEL_FAST=claude-haiku-4-5
# RC_ANTHROPIC_MODEL=claude-sonnet-5-5
# RC_OPENAI_MODEL_FAST=gpt-4o-mini
# RC_OPENAI_MODEL=gpt-4o-mini

# Spend caps in USD; AI-dependent work pauses at either cap (schema.org ingest keeps working).
# RC_AI_DAILY_CAP_USD=1.00
# RC_AI_MONTHLY_CAP_USD=10.00
